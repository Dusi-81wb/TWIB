# TWIB Environment Configuration Example

# Application Settings
APP_NAME=TWIB
APP_VERSION=1.0.0
APP_ENV=development

# Server Configuration
DEBUG=false
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api
LOG_LEVEL=INFO

# Security (JWT secret key - generate a secure 64-char key in production)
SECRET_KEY=your-secure-jwt-secret-key-at-least-32-characters-long!

# Primary Production Database (PostgreSQL) & Dev SQLite Fallback
DATABASE_URL=sqlite+aiosqlite:///./twib.db
# DATABASE_URL=postgresql+asyncpg://twib:twib@localhost:5432/twib

# Cache & Session Storage
REDIS_URL=redis://localhost:6379/0

# Vector Knowledge Database
QDRANT_URL=http://localhost:6333

# OmniRoute LLM Gateway Configuration
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
DEFAULT_MODEL=best-free

# CORS Origins (JSON list of allowed frontend origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Cloud Integration (Optional - Falls back to local SQLite/JWT when empty)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET=workflow-artifacts
# Supabase PostgreSQL connection pooler (Transaction mode, Port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

