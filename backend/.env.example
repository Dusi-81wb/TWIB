# Application
APP_NAME=TWIB
APP_VERSION=0.1.0
APP_ENV=development

# Server
DEBUG=false
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api
LOG_LEVEL=INFO

# Security
SECRET_KEY=twib-development-secret-key-32-chars-minimum!

# Infrastructure
DATABASE_URL=sqlite+aiosqlite:///./twib.db
REDIS_URL=
QDRANT_URL=
OLLAMA_BASE_URL=

# OmniRoute LLM Gateway
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your-omniroute-api-key-here
DEFAULT_MODEL=best-fast

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
